---
import Severity from './Severity.astro';
import { formatDate, splitList } from '../lib/data';
import { formatLag } from '../lib/kev-timing';

interface Row {
  cve_id: string;
  date_published?: string | null;
  severity?: string | null;
  score?: number | null;
  in_kev?: number;
  epss?: number | null;
  vendors?: string | null;
  products?: string | null;
  /** KEV-only, and only when the caller asks for them — see showKevTiming. */
  date_added?: string | null;
  days?: number | null;
  ransomware_known?: number;
}

interface Props {
  rows: Row[];
  showVendor?: boolean;
  caption?: string;
  /**
   * Add the "Added to KEV" and "Days to exploit" columns.
   *
   * Opt-in because this table is shared by the homepage, /years, /categories
   * and /vendors, none of which query those fields — they would render a column
   * of dashes. Only listKevCves supplies them.
   */
  showKevTiming?: boolean;
}

const { rows, showVendor = true, caption, showKevTiming = false } = Astro.props;
---

{/* Wide content scrolls inside its own container — the page body never scrolls sideways. */}
<div class="table-scroll">
  <table>
    {caption && <caption class="sr-only">{caption}</caption>}
    <thead>
      <tr>
        <th scope="col">CVE</th>
        <th scope="col">Published</th>
        {/* Both of these are guarded by the same flag as their <td> counterparts
            below. The header and body are separate loops, so a column added to
            one and not the other shifts every cell in every row without failing
            anything. */}
        {showKevTiming && <th scope="col">Added to KEV</th>}
        {showKevTiming && <th scope="col">Days to exploit</th>}
        <th scope="col">Severity</th>
        {showVendor && <th scope="col">Vendor</th>}
        <th scope="col">Products</th>
        <th scope="col" class="num">EPSS</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td>
              <a class="cve-id" href={`/cve/${row.cve_id}`}>
                {row.cve_id}
              </a>
              {row.in_kev === 1 && (
                <>
                  {' '}
                  <span class="kev-flag" title="Listed in the CISA Known Exploited Vulnerabilities catalog">
                    KEV
                  </span>
                </>
              )}
            </td>
            <td class="muted small">{formatDate(row.date_published ?? null)}</td>
            {showKevTiming && (
              <td class="muted small">
                {formatDate(row.date_added ?? null)}
                {row.ransomware_known === 1 && (
                  <>
                    {' '}
                    <span class="ransom-flag" title="Known ransomware campaign use">
                      RANSOM
                    </span>
                  </>
                )}
              </td>
            )}
            {showKevTiming && (
              <td class="small">
                {/* Written with its unit, never as a bare integer: a lone "0"
                    reads as missing data when it is the most severe value here. */}
                {row.days != null ? formatLag(row.days) : '—'}
              </td>
            )}
            <td>
              <Severity severity={row.severity ?? null} score={row.score ?? null} />
            </td>
            {showVendor && (
              <td class="small">
                {splitList(row.vendors ?? null).map((slug, i) => (
                  <>
                    {i > 0 && ', '}
                    <a href={`/vendors/${slug}`}>{slug}</a>
                  </>
                ))}
              </td>
            )}
            <td class="small muted">
              {splitList(row.products ?? null).slice(0, 3).join(', ')}
              {splitList(row.products ?? null).length > 3 &&
                ` +${splitList(row.products ?? null).length - 3}`}
            </td>
            <td class="num small muted">
              {row.epss != null ? row.epss.toFixed(3) : '—'}
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
  {rows.length === 0 && <p class="empty">No CVEs match these filters.</p>}
</div>

<style>
  .sr-only {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
</style>
