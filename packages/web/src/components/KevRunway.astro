---
import { BANDS, MIN_N, bandsPresent, formatLag } from '../lib/kev-timing';
import type { KevSeries } from '../lib/kev-timing';

interface Props {
  series: KevSeries[];
  /** Column heading for the table twin, naming what each row is. */
  caption: string;
  /** Shown under the chart — denominators and caveats belong here. */
  note?: string;
}

const { series, caption, note } = Astro.props;

// Only buckets something actually falls into. With coverage starting in 2024 the
// "over a year" bucket is empty, and drawing a labelled bar of nothing implies we
// looked there and found none rather than that we could not have looked.
const bands = bandsPresent(series);
const shown = bands.length ? bands : BANDS.slice(0, 1);

/**
 * Bars are scaled against the tallest bar anywhere in the panel, not per row.
 *
 * Per-row scaling would make every product's tallest bucket full height, so a
 * product with one exploited CVE would look identical to one with eight — and
 * comparing products is the entire reason this panel exists. The cost is that
 * small series draw short bars, which is why every non-zero bar carries its
 * count as a number and has a floor height that keeps it visible.
 */
const peak = Math.max(1, ...series.flatMap((s) => shown.map((b) => s.counts[b.key])));
const columns = `repeat(${shown.length}, 1fr)`;
const total = series.reduce((sum, s) => sum + s.n, 0);
---

{/*
  A histogram per series: how many exploited CVEs fell in each window between
  disclosure and CISA documenting exploitation.

  The bars and the axis labels are two rows of ONE grid with the same column
  template, so a label cannot drift out of line with the bar it names — the
  previous version positioned them independently and they disagreed.
*/}
<div class="runway" style={`--runway-cols: ${columns}`}>
  {series.length === 0 && <p class="empty">No exploited CVEs on record for this selection.</p>}

  {
    series.map((s) => (
      <div class="runway-row">
        <div class="runway-name">
          {s.label}
          <span class="runway-n"> n={s.n}</span>
        </div>

        <div
          class="runway-bars"
          role="img"
          aria-label={`${s.label}: ${s.n} exploited ${s.n === 1 ? 'CVE' : 'CVEs'} — ${shown
            .map((b) => `${b.label}: ${s.counts[b.key]}`)
            .join(', ')}. ${
            s.median === null
              ? 'Median withheld, too few observations.'
              : s.median <= 0
                ? 'Median zero days: typically exploited on the day of disclosure.'
                : `Median ${s.median} ${s.median === 1 ? 'day' : 'days'}.`
          }`}
        >
          {shown.map((band) => (
            <div
              class:list={['runway-col', { 'is-median': s.medianBand === band.key }]}
              title={`${band.label}: ${s.counts[band.key]} of ${s.n}`}
            >
              <span class="runway-count">{s.counts[band.key] || ''}</span>
              <span
                class="runway-bar"
                style={`height: ${(s.counts[band.key] / peak) * 100}%`}
                data-empty={s.counts[band.key] === 0 ? '' : undefined}
              />
            </div>
          ))}
        </div>

        <div class="runway-median-value">
          {s.median !== null ? (
            formatLag(s.median)
          ) : (
            <span class="muted" title={`Withheld below ${MIN_N} observations`}>
              —
            </span>
          )}
        </div>
      </div>
    ))
  }

  {
    series.length > 0 && (
      <div class="runway-axis-row">
        <div />
        <div class="runway-axis">
          {shown.map((band) => (
            <span class="runway-tick">{band.label}</span>
          ))}
        </div>
        <div class="runway-axis-caption muted">median</div>
      </div>
    )
  }

  {
    series.some((s) => s.suppressed) && (
      <p class="runway-note muted small">
        A dash means the median is withheld: fewer than {MIN_N} exploited CVEs, where a median
        reads as typical behaviour but is a handful of individual cases. The counts themselves
        are exact.
      </p>
    )
  }

  {note && <p class="runway-note muted small">{note}</p>}

  {
    series.length > 0 && (
      <details class="runway-table">
        <summary>Table view</summary>
        <div class="table-scroll">
          <table>
            <caption class="sr-only">{caption}</caption>
            <thead>
              <tr>
                <th scope="col">{caption}</th>
                {shown.map((band) => (
                  <th scope="col" class="num">
                    {band.label}
                  </th>
                ))}
                <th scope="col" class="num">
                  Total
                </th>
                <th scope="col" class="num">
                  Median
                </th>
              </tr>
            </thead>
            <tbody>
              {series.map((s) => (
                <tr>
                  <th scope="row">{s.label}</th>
                  {shown.map((band) => (
                    <td class="num">{s.counts[band.key].toLocaleString()}</td>
                  ))}
                  <td class="num">{s.n.toLocaleString()}</td>
                  <td class="num">{s.median !== null ? s.median.toLocaleString() : '—'}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="muted small">
          {total.toLocaleString()} observations. Buckets are calendar days from the CVE record
          publishing to CISA listing it as exploited.
        </p>
      </details>
    )
  }
</div>
