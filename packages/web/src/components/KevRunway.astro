---
import { renderRunway } from '../lib/kev-runway-html';
import type { RunwayView } from '../lib/kev-runway-html';

/**
 * Server-rendered default view of the runway histogram.
 *
 * The markup comes from renderRunway, the same function the browser calls when
 * a filter changes, so the page cannot render one shape at build time and a
 * different one after hydration. `set:html` is safe here because that function
 * escapes every value it interpolates — see the note at the top of it.
 *
 * `data-runway` is the handle the filter script re-renders into.
 */
interface Props extends RunwayView {
  /** Identifies which panel this is, so one script can drive several. */
  id: string;
}

const { id, ...view } = Astro.props;
---

<div data-runway={id} set:html={renderRunway(view)} />
