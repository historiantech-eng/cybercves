---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path?: string;
  /** Absolute or root-relative social preview image; defaults to the site card. */
  image?: string;
}

const { title, description, path = Astro.url.pathname, image = '/og-default.png' } = Astro.props;
const site = Astro.site ?? 'https://cybercve.com';
const canonical = new URL(path, site).toString();
const fullTitle = title === 'CyberCVE' ? title : `${title} — CyberCVE`;

// Must be absolute: every social scraper rejects a relative og:image, which is
// how a card silently renders blank.
const ogImage = new URL(image, site).toString();

// Set in CI as PUBLIC_CF_ANALYTICS_TOKEN. Absent locally, so the beacon is simply
// omitted rather than shipping a broken script tag to every dev build.
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN ?? '';

const isHome = path === '/' || path === '/index.html';

const nav = [
  { href: '/', label: 'Overview' },
  { href: '/vendors', label: 'Vendors' },
  { href: '/categories', label: 'Categories' },
  { href: '/compare', label: 'Compare' },
  { href: '/kev', label: 'Exploited' },
  { href: '/methodology', label: 'Methodology' },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="CyberCVE" />
    {/*
      summary_large_image has been declared here since launch with no image to
      go with it, so every share rendered a blank card.
    */}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="CyberCVE — published CVEs across Fortinet, Palo Alto Networks and Cisco, by product category." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="application/rss+xml" title="CyberCVE" href="/rss.xml" />

    {
      isHome && (
        <script
          type="application/ld+json"
          is:inline
          set:html={JSON.stringify({
            '@context': 'https://schema.org',
            '@graph': [
              {
                '@type': 'WebSite',
                '@id': `${site}#website`,
                url: site,
                name: 'CyberCVE',
                description,
                publisher: { '@id': `${site}#org` },
              },
              {
                '@type': 'Organization',
                '@id': `${site}#org`,
                name: 'CyberCVE',
                url: site,
                logo: `${site}og-default.png`,
              },
              {
                // What this site actually is: a derived dataset. Naming its
                // sources here is the same attribution the footer carries, in
                // the form a search engine can read.
                '@type': 'Dataset',
                name: 'CyberCVE vulnerability dataset',
                description:
                  'Published CVEs affecting security products from Fortinet, Palo Alto Networks and Cisco, mapped to product categories with severity, exploitation and discovery attribution.',
                url: `${site}methodology`,
                license: 'https://www.cve.org/Legal/TermsOfUse',
                creator: { '@id': `${site}#org` },
                isBasedOn: [
                  'https://www.cve.org/',
                  'https://www.cisa.gov/known-exploited-vulnerabilities-catalog',
                  'https://www.first.org/epss/',
                ],
              },
            ],
          })}
        />
      )
    }

    {
      analyticsToken && (
        /*
          Cloudflare Web Analytics: no cookies, no cross-site identifier, so the
          site needs no consent banner — a property worth keeping, and stated as
          such on /privacy. `defer` because nothing on the page waits for it.
        */
        <script
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${analyticsToken}"}`}
        />
      )
    }

    <!--
      Applied before first paint so a dark-mode visitor never sees a light flash.

      This one MUST stay `is:inline`: Astro bundles processed scripts as deferred
      modules, and a deferred theme read runs after first paint, which is the
      exact flash this exists to prevent.

      The cost is that Astro does not hash it, so its hash is pinned by hand in
      astro.config.mjs. Change a byte here and the CSP will refuse it — silently,
      taking dark mode with it. `npm test` fails in that case; see
      packages/web/test/csp.test.ts.
    -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('cybercve-theme');
          if (saved === 'dark' || saved === 'light') {
            document.documentElement.dataset.theme = saved;
          }
        } catch {}
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">Cyber<span>CVE</span></a>
        <nav class="site-nav" aria-label="Main">
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={
                  item.href === '/' ? (path === '/' ? 'page' : undefined)
                  : path.startsWith(item.href) ? 'page'
                  : undefined
                }
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
          Theme
        </button>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <strong>CyberCVE</strong> tracks published vulnerabilities across leading security
          vendors, by product category.
        </p>
        <p>
          Data: the <a href="https://www.cve.org/">CVE Program</a> · <a
            href="https://www.cisa.gov/known-exploited-vulnerabilities-catalog">CISA KEV</a
          > · EPSS data courtesy of <a href="https://first.org/epss">FIRST</a>.
        </p>
        <p class="small">
          CVE® is a registered trademark of MITRE. Vendor names and trademarks are used
          nominatively to identify affected products. CVE counts reflect disclosure practice as
          much as product quality — see <a href="/methodology">methodology</a>.
        </p>
        <p class="small footer-links">
          {/*
            Corrections sit first on purpose. This site asserts things about named
            companies, so the way to say "that is wrong" should be the easiest
            link to find down here, not the last.
          */}
          <a href="/feedback">Report a correction</a> · <a href="/privacy">Privacy</a> · <a
            href="/terms">Terms</a
          > · <a href="/.well-known/security.txt">Security</a> · <a
            href="https://github.com/historiantech-eng/cybercves">Source</a
          >
        </p>
      </div>
    </footer>

    {/*
      NOT is:inline — Astro only hashes the scripts it processes, and an
      unhashed inline script is refused by the CSP in astro.config.mjs. This one
      runs on click, so bundling it costs nothing. The pre-paint script in
      <head> cannot be treated the same way; see the note there.
    */}
    <script>
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const root = document.documentElement;
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        const current = root.dataset.theme || (prefersDark ? 'dark' : 'light');
        const next = current === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('cybercve-theme', next);
        } catch {}
      });
    </script>
  </body>
</html>
