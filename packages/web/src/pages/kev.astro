---
import Base from '../layouts/Base.astro';
import CveTable from '../components/CveTable.astro';
import KevRunway from '../components/KevRunway.astro';
import { db } from '../lib/data';
import {
  COHORT_WINDOW_DAYS,
  MIN_N,
  aggregateBy,
  categoriesIn,
  countCves,
  filterRows,
  yearsIn,
} from '../lib/kev-timing';

const repo = db();
const rows = repo ? await repo.listKevCves(300) : [];
const timing = repo ? await repo.getKevTiming() : [];
const vendors = repo ? await repo.listVendors() : [];
const cohort = repo ? await repo.getKevCohortRate(COHORT_WINDOW_DAYS) : [];
const ransomware = rows.filter((r) => r.ransomware_known === 1).length;

const vendorNames = Object.fromEntries(vendors.map((v) => [v.slug, v.name]));
const years = yearsIn(timing);
const categories = categoriesIn(timing);

/**
 * The page opens on firewalls, not on everything.
 *
 * It is the category the vendor ranking already defaults to, and the one where
 * these three vendors are genuinely comparable — a pure-play firewall vendor
 * against a broad portfolio is not a like-for-like read. Falls back to all
 * categories if the corpus ever has no firewall CVEs, so the default cannot
 * silently become an empty page.
 */
const DEFAULT_CATEGORY = categories.some((c) => c.slug === 'firewall') ? 'firewall' : '';

const scope = { categorySlug: DEFAULT_CATEGORY || null };
const shown = filterRows(timing, scope);

// Server renders the default view: all vendors, all years, firewalls. The
// filters re-render client-side with these same functions, so the two cannot
// disagree about a shape.
const byVendor = aggregateBy(timing, 'vendor', { ...scope, labels: vendorNames });
const byProduct = aggregateBy(timing, 'product', scope);
const byDiscovery = aggregateBy(timing, 'discovery', scope);

// Every row ships; the ones outside the default scope ship hidden, so a reader
// without JS sees the same selection the controls claim is active.
const visibleIds = new Set(shown.map((r) => r.cve_id));
const tableRows = rows.map((r) => ({ ...r, hidden: !visibleIds.has(r.cve_id) }));

const trackedCves = countCves(timing);
const linkedCves = countCves(timing.filter((r) => r.product_slug));

// Cohort rates, pivoted to one row per vendor with a column per year.
const cohortYears = [...new Set(cohort.map((r) => r.published_year))].sort((a, b) => a - b);
const cohortByVendor = vendors
  .map((v) => ({
    slug: v.slug,
    name: v.name,
    cells: cohortYears.map(
      (y) => cohort.find((r) => r.vendor_slug === v.slug && r.published_year === y) ?? null,
    ),
  }))
  .filter((r) => r.cells.some(Boolean));
---

<Base
  title="Known exploited"
  description="Tracked cybersecurity vendor CVEs in the CISA KEV catalog, with how long customers had between disclosure and documented exploitation."
>
  <h1>Known exploited</h1>
  <p class="lede">
    CVEs affecting tracked vendors that appear in the CISA KEV catalog. This is the strongest
    available signal: confirmed exploitation in the wild, rather than a severity score that
    predicts it. {rows.length.toLocaleString()} tracked, {ransomware.toLocaleString()} with known
    ransomware campaign use.
  </p>

  {/* One control group for the whole page — every chart below and the table at
      the bottom read from it, so a reader never has two competing selections. */}
  <div class="filters" role="group" aria-label="Exploitation filters">
    <div>
      <label for="kev-vendor">Vendor</label>
      <select id="kev-vendor" data-kev-vendor>
        <option value="">All vendors</option>
        {vendors.map((v) => <option value={v.slug}>{v.name}</option>)}
      </select>
    </div>
    <div>
      <label for="kev-category">Category</label>
      <select id="kev-category" data-kev-category>
        <option value="">All categories</option>
        {
          categories.map((c) => (
            <option value={c.slug} selected={c.slug === DEFAULT_CATEGORY}>
              {c.name}
            </option>
          ))
        }
      </select>
    </div>
    <div>
      <label for="kev-year">Published</label>
      <select id="kev-year" data-kev-year>
        <option value="">All years</option>
        {years.map((y) => <option value={y}>{y}</option>)}
      </select>
    </div>
    <div>
      <label for="kev-compare">Compare</label>
      <select id="kev-compare" data-kev-compare disabled>
        <option value="">No comparison</option>
        <option value="prev">vs previous year</option>
      </select>
    </div>
    <span class="filter-count" data-kev-count>
      {countCves(shown).toLocaleString()} exploited {countCves(shown) === 1 ? 'CVE' : 'CVEs'}
    </span>
  </div>

  {/* Written by the script, because the warning names the year it is about. */}
  <p class="kev-censor small" data-kev-censor hidden></p>

  <section class="section">
    <h2>How much warning did customers get?</h2>
    <p class="lede small">
      How many exploited CVEs fell in each window between the CVE record publishing and CISA
      listing it as exploited. Read this as the outside limit of the defenders' head start,
      not its measure — <strong>the KEV date is when exploitation was documented</strong>,
      which trails when it began by an unknown margin.
    </p>
    <div class="card">
      <KevRunway
        id="vendor"
        series={byVendor}
        caption="Vendor"
        note="Medians this close together, at these counts, are not a ranking — the distributions overlap almost entirely."
      />
    </div>
  </section>

  <section class="section">
    <h2>By product</h2>
    <p class="lede small">
      Which products attackers actually reach for. A product whose bars pile up in the first
      bucket is one being exploited the day it is disclosed.
    </p>
    <div class="card">
      <KevRunway
        id="product"
        series={byProduct}
        caption="Product"
        note={`Products are listed alphabetically, every one with at least one exploited CVE. Counts sum to more than the vendor total: a CVE affecting five products is a real vulnerability in each of them. Medians are shown from ${MIN_N} exploited CVEs upward.`}
      />
    </div>
  </section>

  <section class="section">
    <h2>Who found it changes everything</h2>
    <p class="lede small">
      The same CVEs, grouped by how the vulnerability came to light. This is the one cut of
      the data where the differences are not subtle.
    </p>
    <div class="card">
      <KevRunway
        id="discovery"
        series={byDiscovery}
        caption="Discovery channel"
        note="Vulnerabilities a vendor finds itself reach documented exploitation substantially later than ones reported from outside. Customer-reported bugs cluster at day zero for an unhappy reason: customers tend to report them after being breached. Attribution comes from vendor advisories and CVE credits; see /methodology."
      />
    </div>
    {
      linkedCves < trackedCves && (
        <p class="muted small">
          {(trackedCves - linkedCves).toLocaleString()} of {trackedCves.toLocaleString()} exploited
          CVEs are not yet mapped to a product, so they carry no vendor or category and appear
          only when both of those filters are set to all.
        </p>
      )
    }
  </section>

  {/*
    The honest year-over-year comparison, and the reason the year filter above is
    not one. Cohorts have not been observed for equal time — CVEs published this
    year have had months in which to be exploited where 2024's have had years —
    so their long-lag buckets are emptier for reasons that have nothing to do
    with attackers. This gives every year the same ruler instead.
  */}
  <section class="section">
    <h2>Is it getting better or worse?</h2>
    <p class="lede small">
      Share of each year's CVEs exploited within {COHORT_WINDOW_DAYS} days of publication. Every
      year is measured over the same {COHORT_WINDOW_DAYS}-day window and counts only CVEs old
      enough to have been watched for all of it, so these years are comparable in a way that
      filtering the charts above is not. Whole portfolio, not affected by the filters.
    </p>
    <div class="card">
      <div class="table-scroll">
        <table>
          <caption class="sr-only">
            Share of published CVEs exploited within {COHORT_WINDOW_DAYS} days, by vendor and
            publication year
          </caption>
          <thead>
            <tr>
              <th scope="col">Vendor</th>
              {cohortYears.map((y) => <th scope="col" class="num">{y}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              cohortByVendor.map((row) => (
                <tr>
                  <th scope="row">
                    <a href={`/vendors/${row.slug}`}>{row.name}</a>
                  </th>
                  {row.cells.map((cell) => (
                    <td class="num">
                      {cell && cell.eligible > 0 ? (
                        <>
                          {((cell.exploited / cell.eligible) * 100).toFixed(2)}%
                          <span class="muted small">
                            {' '}
                            {cell.exploited}/{cell.eligible}
                          </span>
                        </>
                      ) : (
                        '—'
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <p class="muted small">
        Denominator is every CVE we attribute to that vendor that year, not only the exploited
        ones — the question is what share of what a vendor shipped got weaponised. The newest
        year's denominator is smaller because CVEs published in the last {COHORT_WINDOW_DAYS} days
        are not yet eligible, not because the vendor published less.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>Every exploited CVE we track</h2>
      <p class="small muted" data-kev-table-note></p>
    </div>
    <p class="lede small">
      Newest KEV additions first, narrowed by the same filters. "Days to exploit" is the measure
      the charts bucket.
    </p>
    <div class="card">
      <CveTable rows={tableRows} caption="Known exploited CVEs" showKevTiming />
      <p class="empty" data-kev-table-empty hidden>No exploited CVEs match these filters.</p>
    </div>
  </section>
</Base>

<script>
  import { aggregateBy, countCves, filterRows } from '../lib/kev-timing';
  import type { KevTimingRow } from '../lib/kev-timing';
  import { renderRunway } from '../lib/kev-runway-html';

  /**
   * One filter set driving three charts and the CVE table.
   *
   * The charts re-aggregate and re-render with renderRunway — the same functions
   * that produced the server's markup, so switching a filter and switching back
   * lands on exactly what the build emitted. The table is not re-rendered: every
   * row is already in the DOM and only its `hidden` flag moves, which keeps the
   * CVE links and their formatting owned by one place.
   */
  const vendorSel = document.querySelector<HTMLSelectElement>('[data-kev-vendor]');
  const catSel = document.querySelector<HTMLSelectElement>('[data-kev-category]');
  const yearSel = document.querySelector<HTMLSelectElement>('[data-kev-year]');
  const cmpSel = document.querySelector<HTMLSelectElement>('[data-kev-compare]');
  const countEl = document.querySelector<HTMLElement>('[data-kev-count]');
  const censorEl = document.querySelector<HTMLElement>('[data-kev-censor]');
  const tableNote = document.querySelector<HTMLElement>('[data-kev-table-note]');
  const tableEmpty = document.querySelector<HTMLElement>('[data-kev-table-empty]');
  const tableRows = Array.from(document.querySelectorAll<HTMLTableRowElement>('tr[data-cve-id]'));

  const vendorPanel = document.querySelector<HTMLElement>('[data-runway="vendor"]');
  const productPanel = document.querySelector<HTMLElement>('[data-runway="product"]');
  const discoveryPanel = document.querySelector<HTMLElement>('[data-runway="discovery"]');

  const PRODUCT_NOTE =
    'Products are listed alphabetically, every one with at least one exploited CVE. Counts sum to more than the vendor total: a CVE affecting five products is a real vulnerability in each of them.';
  const DISCOVERY_NOTE =
    'Vulnerabilities a vendor finds itself reach documented exploitation substantially later than ones reported from outside.';
  const VENDOR_NOTE =
    'Medians this close together, at these counts, are not a ranking — the distributions overlap almost entirely.';

  if (vendorSel && catSel && yearSel && vendorPanel) {
    let rows: KevTimingRow[] = [];
    let vendorNames: Record<string, string> = {};

    const render = () => {
      const vendorSlug = vendorSel.value || undefined;
      const categorySlug = catSel.value || null;
      const year = yearSel.value ? Number(yearSel.value) : null;
      // A comparison needs a year to compare against, so the control only goes
      // live once a single cohort is selected.
      if (cmpSel) cmpSel.disabled = year === null;
      const comparing = year !== null && cmpSel?.value === 'prev';
      const prevYear = comparing ? year - 1 : null;

      const scope = { vendorSlug, categorySlug, year };
      const prevScope = { vendorSlug, categorySlug, year: prevYear };
      const currentLabel = year === null ? 'All years' : String(year);
      const compareLabel = prevYear === null ? '' : String(prevYear);

      const matched = filterRows(rows, scope);
      const n = countCves(matched);
      if (countEl) {
        countEl.textContent = `${n.toLocaleString()} exploited ${n === 1 ? 'CVE' : 'CVEs'}`;
      }

      // Only true when a single cohort is on screen; with all years pooled
      // there is nothing being read across unequal exposure.
      if (censorEl) {
        censorEl.hidden = year === null;
        if (year !== null) {
          censorEl.textContent =
            `CVEs published in ${year} have had less time in which to be exploited than earlier ` +
            `years, so their longer buckets are necessarily emptier. That is observation time, ` +
            `not a change in attacker behaviour — for a fair year-over-year read use the ` +
            `same-ruler comparison further down this page.`;
        }
      }

      vendorPanel.innerHTML = renderRunway({
        series: aggregateBy(rows, 'vendor', { ...scope, labels: vendorNames }),
        compare: comparing
          ? aggregateBy(rows, 'vendor', { ...prevScope, labels: vendorNames })
          : null,
        currentLabel,
        compareLabel,
        caption: 'Vendor',
        note: VENDOR_NOTE,
      });
      if (productPanel) {
        productPanel.innerHTML = renderRunway({
          series: aggregateBy(rows, 'product', scope),
          compare: comparing ? aggregateBy(rows, 'product', prevScope) : null,
          currentLabel,
          compareLabel,
          caption: 'Product',
          note: PRODUCT_NOTE,
        });
      }
      if (discoveryPanel) {
        discoveryPanel.innerHTML = renderRunway({
          series: aggregateBy(rows, 'discovery', scope),
          compare: comparing ? aggregateBy(rows, 'discovery', prevScope) : null,
          currentLabel,
          compareLabel,
          caption: 'Discovery channel',
          note: DISCOVERY_NOTE,
        });
      }

      // The table follows the same selection. A comparison widens it to both
      // cohorts, so the rows on screen are the ones the charts are drawn from.
      const visible = new Set(matched.map((r) => r.cve_id));
      if (comparing) for (const r of filterRows(rows, prevScope)) visible.add(r.cve_id);
      let listed = 0;
      for (const tr of tableRows) {
        const show = visible.has(tr.dataset.cveId ?? '');
        tr.hidden = !show;
        if (show) listed++;
      }
      if (tableNote) {
        tableNote.textContent = `${listed.toLocaleString()} of ${tableRows.length.toLocaleString()} shown`;
      }
      if (tableEmpty) tableEmpty.hidden = listed > 0;
    };

    fetch('/data/kev-timing.json')
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data) return;
        rows = data.rows as KevTimingRow[];
        vendorNames = data.vendorNames ?? {};
        for (const el of [vendorSel, catSel, yearSel, cmpSel]) {
          el?.addEventListener('change', render);
        }
        // Bring the table note and the disabled state in line with the markup
        // the build already produced, without repainting the charts.
        render();
      })
      // The server-rendered panels stay on screen if this fails, so a reader
      // still sees the build's selection rather than an empty card.
      .catch(() => {});
  }
</script>
