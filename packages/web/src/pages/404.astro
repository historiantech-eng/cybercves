---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" description="That page does not exist on CyberCVE.">
  <section class="section">
    <div class="card empty">
      <h1>Not found</h1>
      <p class="muted">
        That page does not exist. A very recently published CVE may not have a page yet — the
        site rebuilds every three hours, and the counter on the front page knows about new
        records before their pages are built.
      </p>
      <p>
        <a href="/">Back to the overview</a> · <a href="/feedback">Report a problem</a>
      </p>
    </div>
  </section>
</Base>
